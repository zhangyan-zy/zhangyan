<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wingscode.modules.common.dao.StoreLogDao">


    <select id="selectAll" resultType="com.wingscode.modules.common.entity.StoreLogEntity">
        select a.*, b.name storeName from tb_store_log a left join tb_store b   on a.store_id=b.id
        where 1=1
        <if test="name !=null and name !='' ">
            and a.msg like concat('%',#{name},'%')
        </if>
    </select>

</mapper>