<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wingscode.modules.common.dao.TypeDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.wingscode.modules.common.entity.TypeEntity" id="typeMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>


    <select id="selectAll" resultType="com.wingscode.modules.common.entity.TypeEntity">
        select t.*,s.name storeName from tb_type t left join tb_store s on t.store_id=s.id
        where 1=1
        <if test="name !=null and name !='' ">
            and t.name like concat('%',#{name},'%')
        </if>
        <if test="storeId !=null and storeId !='' ">
            and t.store_id =#{storeId}
        </if>
    </select>
</mapper>